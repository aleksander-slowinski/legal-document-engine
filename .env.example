# Optional Gemini (only necessary for AI-assisted batch mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional aggregate-only SQL Server telemetry (OFF by default).
SQL_LOGGING_ENABLED=false
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=LegalDocumentEngineDB
SQL_DRIVER=ODBC Driver 17 for SQL Server
